{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--parallel",
        "2"
      ],
      "dependsOn": "Configure",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Test",
      "type": "process",
      "command": "ctest",
      "args": [
        "--test-dir",
        "build",
        "--output-on-failure"
      ],
      "dependsOn": "Build",
      "problemMatcher": []
    }
  ]
}
